<stage stageid="ed4771e8-8c5e-5e1a-9ba9-7bb62ad2ce16" name="Exito" type="Data"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><narrative></narrative><display x="300" y="-105" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="7311cea8-9c47-5592-b507-3b324872e488" name="Descripcion" type="Note"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><narrative>Informa a la plataforma el estado del robot (se muestra en el panel).</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="5d790d90-bf66-50b9-b1d9-6d5ae7cd9a76" name="Start" type="Start"><subsheetid>1ae1d30d-fb52-53b8-b040-31dbe65344ff</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="UrlBase" narrative="" stage="UrlBase" /><input type="text" name="Token" narrative="" stage="Token" /></inputs><onsuccess>f1d65719-b3c0-5159-a454-7760d416e499</onsuccess></stage>
<stage stageid="f1d65719-b3c0-5159-a454-7760d416e499" name="Obtener Institutos" type="Code"><subsheetid>1ae1d30d-fb52-53b8-b040-31dbe65344ff</subsheetid><narrative>Lista los institutos con planificación activa (para distribuir reportes).</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="UrlBase" expr="[UrlBase]" /><input type="text" name="Token" expr="[Token]" /></inputs><outputs><output type="collection" name="Institutos" stage="Institutos" /></outputs><onsuccess>929931a7-370b-5162-a618-18f106504efa</onsuccess><code><![CDATA[
int status;
string resp = Http("GET", UrlUnir(UrlBase, "/api/bot/institutos"), Token, null, out status);
Institutos = new DataTable("Institutos");
Institutos.Columns.Add("IT", typeof(decimal));
Institutos.Columns.Add("Codigo", typeof(string));
Institutos.Columns.Add("Nombre", typeof(string));
Institutos.Columns.Add("Correo", typeof(string));
Institutos.Columns.Add("Resumen", typeof(string));
foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(resp, "\\{[^{}]*\\}"))
{
    string o = m.Value;
    decimal it;
    if (decimal.TryParse(JsonCampo(o, "IT"), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out it))
        Institutos.Rows.Add(it, JsonCampo(o, "Codigo"), JsonCampo(o, "Nombre"), JsonCampo(o, "Correo"), JsonCampo(o, "Resumen"));
}
]]></code></stage>
<stage stageid="929931a7-370b-5162-a618-18f106504efa" name="End" type="End"><subsheetid>1ae1d30d-fb52-53b8-b040-31dbe65344ff</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="collection" name="Institutos" narrative="IT, Codigo, Nombre, Correo, Resumen" stage="Institutos" /></outputs></stage>
