<stage stageid="346b60c6-11e4-5255-ac83-627aa055c854" name="Start" type="Start"><subsheetid>11bc42d8-2633-5c3e-92e5-001c84c655c8</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="Origen" narrative="" stage="Origen" /><input type="text" name="CarpetaDestino" narrative="" stage="CarpetaDestino" /></inputs><onsuccess>b6b2c5c6-0273-58d8-9726-07b9147dba7d</onsuccess></stage>
<stage stageid="b6b2c5c6-0273-58d8-9726-07b9147dba7d" name="Mover Archivo" type="Code"><subsheetid>11bc42d8-2633-5c3e-92e5-001c84c655c8</subsheetid><narrative>Mueve el archivo procesado a otra carpeta agregando fecha y hora al nombre.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="Origen" expr="[Origen]" /><input type="text" name="CarpetaDestino" expr="[CarpetaDestino]" /></inputs><outputs><output type="text" name="NuevaRuta" stage="NuevaRuta" /></outputs><onsuccess>a3a57296-0f20-5705-beb0-c3b3f256e9b7</onsuccess><code><![CDATA[
if (!System.IO.Directory.Exists(CarpetaDestino)) System.IO.Directory.CreateDirectory(CarpetaDestino);
string nombre = System.IO.Path.GetFileNameWithoutExtension(Origen) + "_" + System.DateTime.Now.ToString("yyyyMMdd_HHmmss") + System.IO.Path.GetExtension(Origen);
NuevaRuta = System.IO.Path.Combine(CarpetaDestino, nombre);
System.IO.File.Move(Origen, NuevaRuta);
]]></code></stage>
<stage stageid="a3a57296-0f20-5705-beb0-c3b3f256e9b7" name="End" type="End"><subsheetid>11bc42d8-2633-5c3e-92e5-001c84c655c8</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="text" name="NuevaRuta" narrative="" stage="NuevaRuta" /></outputs></stage>
<stage stageid="26ec9b69-3576-5cb2-bb0f-24a36141ed01" name="Origen" type="Data"><subsheetid>11bc42d8-2633-5c3e-92e5-001c84c655c8</subsheetid><narrative></narrative><display x="180" y="-105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage>
