<stage stageid="13d5107e-6fc3-5bab-9b16-748c71b8d485" name="Carpeta Reportes" type="Data"><narrative>PDF por instituto para jefaturas</narrative><display x="330" y="-65" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">C:\Users\khrva\OneDrive\Desktop\Botathon\robot\Reportes</initialvalue><alwaysinit /></stage>
