<stage stageid="c328e6cb-6711-5e95-90d6-a841fca7c015" name="Login" type="Code"><subsheetid>0d9b0ef8-6aaa-57d4-b4ef-7a2fc3d8c236</subsheetid><narrative>Autentica al robot en la plataforma y obtiene un token JWT.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="UrlBase" expr="[UrlBase]" /><input type="text" name="Email" expr="[Email]" /><input type="text" name="Password" expr="[Password]" /></inputs><outputs><output type="text" name="Token" stage="Token" /><output type="flag" name="Exito" stage="Exito" /><output type="text" name="Mensaje" stage="Mensaje" /></outputs><onsuccess>0e80f131-887a-5067-8e1d-610a826d43d6</onsuccess><code><![CDATA[
int status;
string resp = Http("POST", UrlUnir(UrlBase, "/api/auth/login"), null,
    "{\"email\":\"" + JsonEsc(Email) + "\",\"password\":\"" + JsonEsc(Password) + "\"}", out status);
Token = JsonCampo(resp, "token");
Exito = status == 200 && Token.Length > 0;
Mensaje = Exito ? "Autenticado como " + Email : ("Error " + status + ": " + JsonCampo(resp, "error"));
]]></code></stage>
<stage stageid="0e80f131-887a-5067-8e1d-610a826d43d6" name="End" type="End"><subsheetid>0d9b0ef8-6aaa-57d4-b4ef-7a2fc3d8c236</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="text" name="Token" narrative="Token de sesión" stage="Token" /><output type="flag" name="Exito" narrative="True si autenticó" stage="Exito" /><output type="text" name="Mensaje" narrative="Detalle" stage="Mensaje" /></outputs></stage>
