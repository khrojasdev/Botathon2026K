<stage stageid="47d4bff7-973e-5801-b624-24b33a6594be" name="Start" type="Start"><subsheetid>bddf1172-3313-518b-bc26-b77966abdae4</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="UrlBase" narrative="" stage="UrlBase" /><input type="text" name="Token" narrative="" stage="Token" /><input type="text" name="Tipo" narrative="BUK o SIC" stage="Tipo" /><input type="text" name="Archivo" narrative="Nombre del archivo" stage="Archivo" /><input type="collection" name="Validos" narrative="" stage="Validos" /><input type="collection" name="Errores" narrative="" stage="Errores" /></inputs><onsuccess>97a00248-74d1-57a3-896a-0d9933ee89f5</onsuccess></stage>
<stage stageid="97a00248-74d1-57a3-896a-0d9933ee89f5" name="Enviar Ingesta" type="Code"><subsheetid>bddf1172-3313-518b-bc26-b77966abdae4</subsheetid><narrative>Envía las filas válidas y los errores detectados a la plataforma, que detecta cambios y recalcula la planificación.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="UrlBase" expr="[UrlBase]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Tipo" expr="[Tipo]" /><input type="text" name="Archivo" expr="[Archivo]" /><input type="collection" name="Validos" expr="[Validos]" /><input type="collection" name="Errores" expr="[Errores]" /></inputs><outputs><output type="flag" name="Exito" stage="Exito" /><output type="number" name="IngestaId" stage="IngestaId" /><output type="number" name="Cambios" stage="Cambios" /><output type="text" name="Mensaje" stage="Mensaje" /><output type="text" name="Respuesta" stage="Respuesta" /></outputs><onsuccess>a3fbca7e-b22b-55c4-b6af-993ec7f0b1df</onsuccess><code><![CDATA[
string body = "{\"tipo\":\"" + JsonEsc(Tipo) + "\",\"archivo\":\"" + JsonEsc(Archivo) + "\",\"filas\":" + TablaAJson(Validos) + ",\"errores\":" + TablaAJson(Errores) + "}";
int status;
Respuesta = Http("POST", UrlUnir(UrlBase, "/api/bot/ingesta"), Token, body, out status);
Exito = status == 200;
decimal n;
IngestaId = decimal.TryParse(JsonCampo(Respuesta, "ingesta_id"), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out n) ? n : 0;
Cambios = decimal.TryParse(JsonCampo(Respuesta, "cambios"), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out n) ? n : 0;
Mensaje = Exito ? JsonCampo(Respuesta, "mensaje") : ("Error " + status + ": " + JsonCampo(Respuesta, "error"));
]]></code></stage>
<stage stageid="a3fbca7e-b22b-55c4-b6af-993ec7f0b1df" name="End" type="End"><subsheetid>bddf1172-3313-518b-bc26-b77966abdae4</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="flag" name="Exito" narrative="" stage="Exito" /><output type="number" name="IngestaId" narrative="" stage="IngestaId" /><output type="number" name="Cambios" narrative="Cambios detectados (altas, bajas, jornada…)" stage="Cambios" /><output type="text" name="Mensaje" narrative="" stage="Mensaje" /><output type="text" name="Respuesta" narrative="JSON completo" stage="Respuesta" /></outputs></stage>
