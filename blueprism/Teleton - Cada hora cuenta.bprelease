<stage stageid="c66c1ac0-8cde-5b74-b143-e9dc99e35a4e" name="Ruta" type="Data"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative>Dónde guardarlo</narrative><display x="180" y="-25" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="1a83bfbe-64fc-52ce-b5d3-1b13796e6ad1" name="Exito" type="Data"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative></narrative><display x="300" y="-105" w="90" h="30" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="f655e353-06ae-5a4a-b399-bea145457d80" name="Bytes" type="Data"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative></narrative><display x="300" y="-65" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="70b0792e-263a-53f1-8670-9a334ef2d8d9" name="Descripcion" type="Note"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative>Descarga un archivo autenticado (ej. PDF de un instituto) y lo guarda en disco.</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="e5dd0a77-8bcd-5ebf-9f85-2cc1d8e6c7ed" name="Start" type="Start"><subsheetid>1fdbda89-f639-5211-9115-2f08d189a368</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="Para" narrative="Correo de la jefatura" stage="Para" /><input type="text" name="Asunto" narrative="" stage="Asunto" /><input type="text" name="Cuerpo" narrative="Texto del correo" stage="Cuerpo" /><input type="text" name="Adjunto" narrative="Ruta del PDF (opcional)" stage="Adjunto" /><input type="text" name="Carpeta" narrative="Dónde dejar el borrador" stage="Carpeta" /></inputs><onsuccess>a3c8ab24-cefd-5a89-8f8c-d2cda57f04fd</onsuccess></stage>
<stage stageid="a3c8ab24-cefd-5a89-8f8c-d2cda57f04fd" name="Preparar Correo" type="Code"><subsheetid>1fdbda89-f639-5211-9115-2f08d189a368</subsheetid><narrative>Deja un borrador de correo (.eml) con el PDF adjunto para la jefatura. No envía nada: el borrador se abre con doble clic en Outlook y se revisa antes de enviar.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="Para" expr="[Para]" /><input type="text" name="Asunto" expr="[Asunto]" /><input type="text" name="Cuerpo" expr="[Cuerpo]" /><input type="text" name="Adjunto" expr="[Adjunto]" /><input type="text" name="Carpeta" expr="[Carpeta]" /></inputs><outputs><output type="text" name="RutaEml" stage="RutaEml" /></outputs><onsuccess>1490fec8-810e-5c57-ac86-30546b722ab1</onsuccess><code><![CDATA[
if (!System.IO.Directory.Exists(Carpeta)) System.IO.Directory.CreateDirectory(Carpeta);
var enc = System.Text.Encoding.UTF8;
string limite = "----=_ChC_" + System.Guid.NewGuid().ToString("N");
var sb = new System.Text.StringBuilder();
sb.Append("X-Unsent: 1\r\n");
sb.Append("To: " + Para + "\r\n");
sb.Append("Subject: =?utf-8?B?" + System.Convert.ToBase64String(enc.GetBytes(Asunto ?? "")) + "?=\r\n");
sb.Append("MIME-Version: 1.0\r\n");
sb.Append("Content-Type: multipart/mixed; boundary=\"" + limite + "\"\r\n\r\n");
sb.Append("--" + limite + "\r\n");
sb.Append("Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\n");
sb.Append(System.Convert.ToBase64String(enc.GetBytes(Cuerpo ?? ""), System.Base64FormattingOptions.InsertLineBreaks) + "\r\n");
if (!string.IsNullOrEmpty(Adjunto) && System.IO.File.Exists(Adjunto))
{
    string nombre = System.IO.Path.GetFileName(Adjunto);
    sb.Append("--" + limite + "\r\n");
    sb.Append("Content-Type: application/pdf; name=\"" + nombre + "\"\r\nContent-Transfer-Encoding: base64\r\n");
    sb.Append("Content-Disposition: attachment; filename=\"" + nombre + "\"\r\n\r\n");
    sb.Append(System.Convert.ToBase64String(System.IO.File.ReadAllBytes(Adjunto), System.Base64FormattingOptions.InsertLineBreaks) + "\r\n");
}
sb.Append("--" + limite + "--\r\n");
string baseNombre = string.IsNullOrEmpty(Adjunto) ? "Correo" : System.IO.Path.GetFileNameWithoutExtension(Adjunto);
RutaEml = System.IO.Path.Combine(Carpeta, baseNombre + ".eml");
System.IO.File.WriteAllText(RutaEml, sb.ToString(), new System.Text.UTF8Encoding(false));
]]></code></stage>
<stage stageid="1490fec8-810e-5c57-ac86-30546b722ab1" name="End" type="End"><subsheetid>1fdbda89-f639-5211-9115-2f08d189a368</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="text" name="RutaEml" narrative="Ruta del borrador creado" stage="RutaEml" /></outputs></stage>
<stage stageid="a1e21f9d-9490-5dac-acd9-573867f6566c" name="Para" type="Data"><subsheetid>1fdbda89-f639-5211-9115-2f08d189a368</subsheetid><narrative>Correo de la jefatura</narrative><display x="180" y="-105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage>
