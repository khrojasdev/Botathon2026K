<stage stageid="f8ba716b-0a5e-534a-9d0f-7428ec3f9fa3" name="Descripcion" type="Note"><subsheetid>a61b4277-8193-5fcf-8f0a-eec7ec3207a4</subsheetid><narrative>Lee la primera hoja de un .xlsx (sin necesitar Microsoft Excel instalado). Detecta la fila de encabezado buscando "PersonaId".</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="fb7da4dc-e859-539c-9404-49b119d6e607" name="Start" type="Start"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="collection" name="Datos" narrative="Salida de Leer Excel" stage="Datos" /><input type="number" name="JornadaMaxEneAbr" narrative="Jornada legal ene–abr (44)" stage="JornadaMaxEneAbr" /><input type="number" name="JornadaMaxMayDic" narrative="Jornada legal may–dic (42)" stage="JornadaMaxMayDic" /></inputs><onsuccess>06b6c45e-fd04-556b-b7c1-5a02b2763337</onsuccess></stage>
<stage stageid="06b6c45e-fd04-556b-b7c1-5a02b2763337" name="Validar Reporte BUK" type="Code"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Valida el reporte de dotación BUK: IDs, instituto, periodo, horas vs. jornada legal, cargo, fechas, duplicados.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="collection" name="Datos" expr="[Datos]" /><input type="number" name="JornadaMaxEneAbr" expr="[JornadaMaxEneAbr]" /><input type="number" name="JornadaMaxMayDic" expr="[JornadaMaxMayDic]" /></inputs><outputs><output type="collection" name="Validos" stage="Validos" /><output type="collection" name="Errores" stage="Errores" /><output type="number" name="CantValidos" stage="CantValidos" /><output type="number" name="CantErrores" stage="CantErrores" /></outputs><onsuccess>5cb48e80-da5e-5261-a609-1636faa70e9b</onsuccess><code><![CDATA[
Validos = Datos.Clone();
Errores = NuevaTablaErrores();
decimal maxA = JornadaMaxEneAbr > 0 ? JornadaMaxEneAbr : 44;
decimal maxB = JornadaMaxMayDic > 0 ? JornadaMaxMayDic : 42;
var vistos = new System.Collections.Generic.Dictionary<string, decimal>();
foreach (DataRow r in Datos.Rows)
{
    decimal fila = Datos.Columns.Contains("Fila") ? System.Convert.ToDecimal(r["Fila"]) : Datos.Rows.IndexOf(r) + 2;
    var errs = new System.Collections.Generic.List<string[]>();
    string pid = Col(r, "PersonaId"), it = Col(r, "IT"), per = Col(r, "Periodo"), hs = Col(r, "Horas Semanales"), cargo = Col(r, "Cargo");
    string fi = Col(r, "Fecha Ingreso Compañía", "Fecha Ingreso"), ft = Col(r, "Fecha Término", "Fecha Termino"), nd = Col(r, "Ndias");
    decimal npid = Num(pid);
    if (npid <= 0 || npid != System.Math.Floor(npid)) errs.Add(new[] { "PersonaId", pid, "PersonaId vacío o no numérico" });
    if (Num(it) <= 0) errs.Add(new[] { "IT", it, "Código de instituto vacío o inválido" });
    var dper = Fecha(per);
    if (dper == null) errs.Add(new[] { "Periodo", per, "Periodo vacío o con formato inválido" });
    decimal h = Num(hs);
    if (h < 0) errs.Add(new[] { "Horas Semanales", hs, "Horas semanales vacías o no numéricas" });
    else if (h == 0) errs.Add(new[] { "Horas Semanales", hs, "Horas semanales deben ser mayores a 0" });
    else if (dper != null)
    {
        decimal max = dper.Value.Month <= 4 ? maxA : maxB;
        if (h > max) errs.Add(new[] { "Horas Semanales", hs, "Supera la jornada legal vigente (" + max + " h)" });
    }
    if (cargo.Length == 0) errs.Add(new[] { "Cargo", cargo, "Cargo vacío" });
    var dfi = Fecha(fi); var dft = Fecha(ft);
    if (fi.Length > 0 && dfi == null) errs.Add(new[] { "Fecha Ingreso", fi, "Fecha de ingreso inválida" });
    if (ft.Length > 0 && dft == null) errs.Add(new[] { "Fecha Término", ft, "Fecha de término inválida" });
    if (dfi != null && dft != null && dft < dfi) errs.Add(new[] { "Fecha Término", ft, "Fecha de término anterior a la fecha de ingreso" });
    if (nd.Length > 0 && (Num(nd) < 1 || Num(nd) > 7)) errs.Add(new[] { "Ndias", nd, "Días de jornada fuera de rango (1-7)" });
    if (errs.Count == 0)
    {
        string key = pid + "|" + it + "|" + dper.Value.ToString("yyyy-MM");
        if (vistos.ContainsKey(key)) errs.Add(new[] { "PersonaId", pid, "Registro duplicado (igual a la fila " + vistos[key] + ")" });
        else vistos[key] = fila;
    }
    foreach (var e in errs) Errores.Rows.Add(fila, e[0], e[1], e[2], "error", pid);
    if (errs.Count == 0) Validos.ImportRow(r);
}
CantValidos = Validos.Rows.Count;
CantErrores = Errores.Rows.Count;
]]></code></stage>
<stage stageid="5cb48e80-da5e-5261-a609-1636faa70e9b" name="End" type="End"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="collection" name="Validos" narrative="Filas válidas" stage="Validos" /><output type="collection" name="Errores" narrative="Fila, Campo, Valor, Mensaje, Severidad, PersonaId" stage="Errores" /><output type="number" name="CantValidos" narrative="" stage="CantValidos" /><output type="number" name="CantErrores" narrative="" stage="CantErrores" /></outputs></stage>
