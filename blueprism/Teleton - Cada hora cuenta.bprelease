<stage stageid="a5f470ca-1ab9-5fbd-b7d8-275557e1784e" name="Descripcion" type="Note"><subsheetid>bddf1172-3313-518b-bc26-b77966abdae4</subsheetid><narrative>Envía las filas válidas y los errores detectados a la plataforma, que detecta cambios y recalcula la planificación.</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="4769bb72-81e9-5500-af44-d45320d0d8f1" name="Start" type="Start"><subsheetid>2ce8fdf8-30d7-5f98-85f7-1c55d45e6fca</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="collection" name="Errores" narrative="" stage="Errores" /><input type="text" name="Ruta" narrative="Ruta del CSV a crear" stage="Ruta" /></inputs><onsuccess>222e5635-8708-5b5b-9889-3d96bde71b39</onsuccess></stage>
<stage stageid="222e5635-8708-5b5b-9889-3d96bde71b39" name="Guardar Errores CSV" type="Code"><subsheetid>2ce8fdf8-30d7-5f98-85f7-1c55d45e6fca</subsheetid><narrative>Escribe los errores detectados en un CSV (UTF-8, separador ;) para informar a Gerencia de Personas.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="collection" name="Errores" expr="[Errores]" /><input type="text" name="Ruta" expr="[Ruta]" /></inputs><outputs><output type="flag" name="Exito" stage="Exito" /></outputs><onsuccess>d367fb11-ddfc-5164-9d69-ccc1dc90bfa6</onsuccess><code><![CDATA[
string dir = System.IO.Path.GetDirectoryName(Ruta);
if (!string.IsNullOrEmpty(dir) && !System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
var sb = new System.Text.StringBuilder();
for (int j = 0; j < Errores.Columns.Count; j++) { if (j > 0) sb.Append(";"); sb.Append(Errores.Columns[j].ColumnName); }
sb.AppendLine();
foreach (DataRow r in Errores.Rows)
{
    for (int j = 0; j < Errores.Columns.Count; j++)
    {
        if (j > 0) sb.Append(";");
        string v = System.Convert.ToString(r[j]) ?? "";
        sb.Append("\"").Append(v.Replace("\"", "\"\"")).Append("\"");
    }
    sb.AppendLine();
}
System.IO.File.WriteAllText(Ruta, sb.ToString(), new System.Text.UTF8Encoding(true));
Exito = true;
]]></code></stage>
<stage stageid="d367fb11-ddfc-5164-9d69-ccc1dc90bfa6" name="End" type="End"><subsheetid>2ce8fdf8-30d7-5f98-85f7-1c55d45e6fca</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="flag" name="Exito" narrative="" stage="Exito" /></outputs></stage>
<stage stageid="44457df8-83c5-559b-98d8-d58dc20ca167" name="Errores" type="Collection"><subsheetid>2ce8fdf8-30d7-5f98-85f7-1c55d45e6fca</subsheetid><narrative></narrative><display x="180" y="-105" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage>
