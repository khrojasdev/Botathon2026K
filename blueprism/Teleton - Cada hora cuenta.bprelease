<stage stageid="28643ce4-1f5e-50a4-9bfb-5979819203f8" name="JornadaMaxEneAbr" type="Data"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Jornada legal ene–abr (44)</narrative><display x="180" y="-65" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="f7b95a31-7541-56ff-ac6f-cd74ec05a632" name="JornadaMaxMayDic" type="Data"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Jornada legal may–dic (42)</narrative><display x="180" y="-25" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="d6900468-a6f9-583e-8e74-d1048f068cc3" name="Validos" type="Collection"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Filas válidas</narrative><display x="300" y="-105" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage>
<stage stageid="31cc134a-f1a2-5103-bb22-43450abd3f22" name="Errores" type="Collection"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Fila, Campo, Valor, Mensaje, Severidad, PersonaId</narrative><display x="300" y="-65" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Fila" type="number" /><field name="Campo" type="text" /><field name="Valor" type="text" /><field name="Mensaje" type="text" /><field name="Severidad" type="text" /><field name="PersonaId" type="text" /></collectioninfo></stage>
<stage stageid="21fa2893-7b0d-53e8-b19f-06227835ac50" name="CantValidos" type="Data"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative></narrative><display x="300" y="-25" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="7dde5fed-de8e-5f34-8c57-5ac2ce78b726" name="CantErrores" type="Data"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative></narrative><display x="300" y="15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="c4085d66-e23f-56b5-bfbf-c2529cc75dbf" name="Descripcion" type="Note"><subsheetid>d23dbb02-71a8-5446-be9f-9580cdb75f20</subsheetid><narrative>Valida el reporte de dotación BUK: IDs, instituto, periodo, horas vs. jornada legal, cargo, fechas, duplicados.</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="b3df61fa-1283-5b74-a4a5-e21edadecbfa" name="Start" type="Start"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="collection" name="Datos" narrative="Salida de Leer Excel" stage="Datos" /></inputs><onsuccess>29b8ff94-ae6e-5c2a-a30e-6f4915998265</onsuccess></stage>
<stage stageid="29b8ff94-ae6e-5c2a-a30e-6f4915998265" name="Validar Reporte SIC" type="Code"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><narrative>Valida el reporte de atenciones realizadas del SIC.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="collection" name="Datos" expr="[Datos]" /></inputs><outputs><output type="collection" name="Validos" stage="Validos" /><output type="collection" name="Errores" stage="Errores" /><output type="number" name="CantValidos" stage="CantValidos" /><output type="number" name="CantErrores" stage="CantErrores" /></outputs><onsuccess>5bfe1afa-bc43-569c-9adf-3220e4312a7f</onsuccess><code><![CDATA[
Validos = Datos.Clone();
Errores = NuevaTablaErrores();
var vistos = new System.Collections.Generic.HashSet<string>();
foreach (DataRow r in Datos.Rows)
{
    decimal fila = Datos.Columns.Contains("Fila") ? System.Convert.ToDecimal(r["Fila"]) : Datos.Rows.IndexOf(r) + 2;
    var errs = new System.Collections.Generic.List<string[]>();
    string pid = Col(r, "PersonaId"), it = Col(r, "IT"), per = Col(r, "Periodo");
    string d = Col(r, "Atenciones Directas", "Directas"), ind = Col(r, "Atenciones Indirectas", "Indirectas");
    if (Num(pid) <= 0) errs.Add(new[] { "PersonaId", pid, "PersonaId vacío o no numérico" });
    if (Num(it) <= 0) errs.Add(new[] { "IT", it, "Instituto inválido" });
    var dp = Fecha(per);
    if (dp == null) errs.Add(new[] { "Periodo", per, "Periodo inválido" });
    decimal dv, iv;
    if (!decimal.TryParse(d.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out dv)) errs.Add(new[] { "Atenciones Directas", d, "Valor vacío o no numérico" });
    else if (dv < 0) errs.Add(new[] { "Atenciones Directas", d, "Atenciones negativas" });
    if (ind.Length > 0 && (!decimal.TryParse(ind.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out iv) || iv < 0)) errs.Add(new[] { "Atenciones Indirectas", ind, "Atenciones negativas o no numéricas" });
    if (errs.Count == 0)
    {
        string key = pid + "|" + it + "|" + dp.Value.ToString("yyyy-MM");
        if (!vistos.Add(key)) errs.Add(new[] { "PersonaId", pid, "Registro duplicado" });
    }
    foreach (var e in errs) Errores.Rows.Add(fila, e[0], e[1], e[2], "error", pid);
    if (errs.Count == 0) Validos.ImportRow(r);
}
CantValidos = Validos.Rows.Count;
CantErrores = Errores.Rows.Count;
]]></code></stage>
<stage stageid="5bfe1afa-bc43-569c-9adf-3220e4312a7f" name="End" type="End"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="collection" name="Validos" narrative="Filas válidas" stage="Validos" /><output type="collection" name="Errores" narrative="Fila, Campo, Valor, Mensaje, Severidad, PersonaId" stage="Errores" /><output type="number" name="CantValidos" narrative="" stage="CantValidos" /><output type="number" name="CantErrores" narrative="" stage="CantErrores" /></outputs></stage>
