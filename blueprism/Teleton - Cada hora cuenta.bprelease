<stage stageid="f419af4f-5b2d-55fe-a009-5e84de151caa" name="Start" type="Start"><subsheetid>a61b4277-8193-5fcf-8f0a-eec7ec3207a4</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="Ruta" narrative="Ruta completa del archivo" stage="Ruta" /></inputs><onsuccess>d6451386-e3c5-56c6-a4a2-8e0f7ecb59cf</onsuccess></stage>
<stage stageid="d6451386-e3c5-56c6-a4a2-8e0f7ecb59cf" name="Leer Excel" type="Code"><subsheetid>a61b4277-8193-5fcf-8f0a-eec7ec3207a4</subsheetid><narrative>Lee la primera hoja de un .xlsx (sin necesitar Microsoft Excel instalado). Detecta la fila de encabezado buscando "PersonaId".</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="Ruta" expr="[Ruta]" /></inputs><outputs><output type="collection" name="Datos" stage="Datos" /><output type="number" name="Filas" stage="Filas" /><output type="text" name="Hoja" stage="Hoja" /></outputs><onsuccess>5c63ef02-a951-5571-8e7b-cb76fd7d8b31</onsuccess><code><![CDATA[
string h;
Datos = LeerXlsx(Ruta, out h);
Hoja = h;
Filas = Datos.Rows.Count;
]]></code></stage>
<stage stageid="5c63ef02-a951-5571-8e7b-cb76fd7d8b31" name="End" type="End"><subsheetid>a61b4277-8193-5fcf-8f0a-eec7ec3207a4</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="collection" name="Datos" narrative="Filas del reporte (columna Fila = n° de fila en Excel)" stage="Datos" /><output type="number" name="Filas" narrative="Cantidad de filas" stage="Filas" /><output type="text" name="Hoja" narrative="Nombre de la hoja leída" stage="Hoja" /></outputs></stage>
