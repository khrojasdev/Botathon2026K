<stage stageid="c3c79f73-115c-54f0-8113-407105b5aade" name="Carpeta Entrada" type="Data"><narrative>Aquí GP deja los reportes BUK y SIC</narrative><display x="450" y="-165" w="90" h="30" /><datatype>text</datatype><initialvalue xml:space="preserve">C:\Users\khrva\OneDrive\Desktop\Botathon\robot\Entrada</initialvalue><alwaysinit /></stage>
