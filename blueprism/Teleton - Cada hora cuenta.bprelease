<stage stageid="30bec8de-ae95-5f02-8c61-2d7f84412cc4" name="Start" type="Start"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="Url" narrative="URL completa" stage="Url" /><input type="text" name="Token" narrative="" stage="Token" /><input type="text" name="Ruta" narrative="Dónde guardarlo" stage="Ruta" /></inputs><onsuccess>36f77293-b2fa-5cba-90d8-8ebb8d4516b5</onsuccess></stage>
<stage stageid="36f77293-b2fa-5cba-90d8-8ebb8d4516b5" name="Descargar Archivo" type="Code"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative>Descarga un archivo autenticado (ej. PDF de un instituto) y lo guarda en disco.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="Url" expr="[Url]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Ruta" expr="[Ruta]" /></inputs><outputs><output type="flag" name="Exito" stage="Exito" /><output type="number" name="Bytes" stage="Bytes" /></outputs><onsuccess>c14db802-e805-5003-96c8-60b83ea20c4f</onsuccess><code><![CDATA[
System.Net.ServicePointManager.SecurityProtocol = (System.Net.SecurityProtocolType)3072;
string dir = System.IO.Path.GetDirectoryName(Ruta);
if (!string.IsNullOrEmpty(dir) && !System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
using (var wc = new System.Net.WebClient())
{
    wc.Headers["Authorization"] = "Bearer " + Token;
    wc.DownloadFile(Url, Ruta);
}
var fi = new System.IO.FileInfo(Ruta);
Bytes = fi.Length;
Exito = fi.Length > 0;
]]></code></stage>
<stage stageid="c14db802-e805-5003-96c8-60b83ea20c4f" name="End" type="End"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="flag" name="Exito" narrative="" stage="Exito" /><output type="number" name="Bytes" narrative="" stage="Bytes" /></outputs></stage>
<stage stageid="f05cbc4a-eb7e-5a83-b3cd-8011e16ff257" name="Url" type="Data"><subsheetid>aaf9f03f-f892-57b9-bd89-d5c1f45e6532</subsheetid><narrative>URL completa</narrative><display x="180" y="-105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage>
