<stage stageid="7909d6e1-9d78-57f2-8e9a-1958ae75affc" name="Descripcion" type="Note"><subsheetid>0d9b0ef8-6aaa-57d4-b4ef-7a2fc3d8c236</subsheetid><narrative>Autentica al robot en la plataforma y obtiene un token JWT.</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="6c3c9482-0ce0-58b3-8cbc-d65f22609712" name="Start" type="Start"><subsheetid>592ad4cc-4c14-5677-9469-8cb7ecc0a092</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="Carpeta" narrative="Carpeta de entrada" stage="Carpeta" /><input type="text" name="Patron" narrative="Patrón, ej. *.xlsx" stage="Patron" /></inputs><onsuccess>8457e42a-98d6-5d3d-b441-ceffbf7d6cf1</onsuccess></stage>
<stage stageid="8457e42a-98d6-5d3d-b441-ceffbf7d6cf1" name="Listar Archivos" type="Code"><subsheetid>592ad4cc-4c14-5677-9469-8cb7ecc0a092</subsheetid><narrative>Lista los Excel pendientes en la carpeta de entrada y deduce si son BUK o SIC por su nombre.</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="Carpeta" expr="[Carpeta]" /><input type="text" name="Patron" expr="[Patron]" /></inputs><outputs><output type="collection" name="Archivos" stage="Archivos" /><output type="number" name="Cantidad" stage="Cantidad" /></outputs><onsuccess>428644f8-5d62-52b6-be50-0d368c4a7790</onsuccess><code><![CDATA[
Archivos = new DataTable("Archivos");
Archivos.Columns.Add("Nombre", typeof(string));
Archivos.Columns.Add("Ruta", typeof(string));
Archivos.Columns.Add("Tipo", typeof(string));
if (!System.IO.Directory.Exists(Carpeta)) System.IO.Directory.CreateDirectory(Carpeta);
string patron = string.IsNullOrEmpty(Patron) ? "*.xlsx" : Patron;
var lista = new System.IO.DirectoryInfo(Carpeta).GetFiles(patron);
System.Array.Sort(lista, (a, b) => a.LastWriteTime.CompareTo(b.LastWriteTime));
foreach (var f in lista)
{
    if (f.Name.StartsWith("~$")) continue; // archivo temporal de Excel abierto
    string n = Norm(f.Name);
    string tipo = n.Contains("sic") ? "SIC" : (n.Contains("buk") || n.Contains("contrato") || n.Contains("dotacion")) ? "BUK" : "DESCONOCIDO";
    Archivos.Rows.Add(f.Name, f.FullName, tipo);
}
Cantidad = Archivos.Rows.Count;
]]></code></stage>
<stage stageid="428644f8-5d62-52b6-be50-0d368c4a7790" name="End" type="End"><subsheetid>592ad4cc-4c14-5677-9469-8cb7ecc0a092</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="collection" name="Archivos" narrative="Nombre, Ruta, Tipo" stage="Archivos" /><output type="number" name="Cantidad" narrative="Cantidad de archivos" stage="Cantidad" /></outputs></stage>
