<process id="6f8193d8-da79-5e7c-9080-f14cc58a8b79" name="Teleton - Ingesta BUK SIC v2" xmlns="http://www.blueprism.co.uk/product/process">
<process xmlns="http://www.blueprism.co.uk/product/process" name="Teleton - Ingesta BUK SIC v2" version="1.0" bpversion="6.10.1.12345" narrative='Automatiza la incorporación de reportes BUK y SIC a la planificación asistencial y distribuye los reportes por instituto. Versión 2: usa la cola de trabajo "Teleton - Reportes" (un ítem por archivo, con reintentos y trazabilidad en Control Room) y deja borradores de correo para cada jefatura.' byrefcollection="true">
<view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view>
