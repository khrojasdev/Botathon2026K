<stage stageid="62ff9115-f7f7-5539-a0f5-eaa5d2f972b1" name="Descripcion" type="Note"><subsheetid>11bc42d8-2633-5c3e-92e5-001c84c655c8</subsheetid><narrative>Mueve el archivo procesado a otra carpeta agregando fecha y hora al nombre.</narrative><display x="-180" y="-105" w="180" h="60" /></stage>
<stage stageid="c7ddde53-8dc4-51b6-91f6-608f36d0284e" name="Start" type="Start"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><loginhibit /><display x="15" y="-105" w="60" h="30" /><inputs><input type="text" name="UrlBase" narrative="" stage="UrlBase" /><input type="text" name="Token" narrative="" stage="Token" /><input type="text" name="Mensaje" narrative="" stage="Mensaje" /><input type="number" name="Archivos" narrative="Archivos en la corrida" stage="Archivos" /></inputs><onsuccess>7b2d0afc-02b8-5432-8b60-a70d2e9d9b6f</onsuccess></stage>
<stage stageid="7b2d0afc-02b8-5432-8b60-a70d2e9d9b6f" name="Latido" type="Code"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><narrative>Informa a la plataforma el estado del robot (se muestra en el panel).</narrative><loginhibit /><display x="15" y="-15" w="90" h="45" /><inputs><input type="text" name="UrlBase" expr="[UrlBase]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Mensaje" expr="[Mensaje]" /><input type="number" name="Archivos" expr="[Archivos]" /></inputs><outputs><output type="flag" name="Exito" stage="Exito" /></outputs><onsuccess>60d7a3e1-c977-5e7c-9f2c-01013769c08c</onsuccess><code><![CDATA[
int status;
string body = "{\"mensaje\":\"" + JsonEsc(Mensaje) + "\",\"maquina\":\"" + JsonEsc(System.Environment.MachineName) + "\",\"ejecucion\":{\"archivos\":" + System.Convert.ToString(Archivos, System.Globalization.CultureInfo.InvariantCulture) + "}}";
Http("POST", UrlUnir(UrlBase, "/api/bot/heartbeat"), Token, body, out status);
Exito = status == 200;
]]></code></stage>
<stage stageid="60d7a3e1-c977-5e7c-9f2c-01013769c08c" name="End" type="End"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><loginhibit /><display x="15" y="90" w="60" h="30" /><outputs><output type="flag" name="Exito" narrative="" stage="Exito" /></outputs></stage>
<stage stageid="b15ac111-25bf-5e5c-90c5-0bd055a4a1ed" name="UrlBase" type="Data"><subsheetid>3751451c-fcf9-5027-ad8e-c1fdf24958b1</subsheetid><narrative></narrative><display x="180" y="-105" w="90" h="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage>
