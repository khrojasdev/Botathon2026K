<stage stageid="96ee6787-564f-5f78-aa84-20e4a8d21c4a" name="Validos" type="Collection"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><narrative>Filas válidas</narrative><display x="300" y="-105" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /></stage>
<stage stageid="e5a98d44-93e8-5ea2-83b1-2753c99d3005" name="Errores" type="Collection"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><narrative>Fila, Campo, Valor, Mensaje, Severidad, PersonaId</narrative><display x="300" y="-65" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Fila" type="number" /><field name="Campo" type="text" /><field name="Valor" type="text" /><field name="Mensaje" type="text" /><field name="Severidad" type="text" /><field name="PersonaId" type="text" /></collectioninfo></stage>
<stage stageid="1cead710-1fbd-5bf4-995a-d5506733f8b4" name="CantValidos" type="Data"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><narrative></narrative><display x="300" y="-25" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
<stage stageid="57b2d22f-a0a9-5243-ae89-0f94deea7c68" name="CantErrores" type="Data"><subsheetid>f8ae5e6d-ce32-594f-b181-1079d3e4e49c</subsheetid><narrative></narrative><display x="300" y="15" w="90" h="30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage>
