<stage stageid="0fc99952-428e-5045-b3a0-344a6e9219b3" name="Start" type="Start"><loginhibit /><display x="15" y="-255" w="60" h="30" /><onsuccess>8dd530c2-e987-5d36-89fd-17cb099e3383</onsuccess></stage>
<stage stageid="8dd530c2-e987-5d36-89fd-17cb099e3383" name="Login plataforma" type="Action"><narrative>Obtiene un token JWT con la cuenta técnica del robot (rol bot).</narrative><loginhibit onsuccess="true" /><display x="15" y="-195" w="90" h="30" /><inputs><input type="text" name="UrlBase" expr="[URL API]" /><input type="text" name="Email" expr="[Email Robot]" /><input type="text" name="Password" expr="[Password Robot]" /></inputs><outputs><output type="text" name="Token" stage="Token" /><output type="flag" name="Exito" stage="Login OK" /><output type="text" name="Mensaje" stage="Mensaje" /></outputs><onsuccess>7540a3f1-35d6-56d5-b8bd-70255ebbf354</onsuccess><resource object="Teleton - API Conector" action="Login" /></stage>
<stage stageid="7540a3f1-35d6-56d5-b8bd-70255ebbf354" name="¿Login OK?" type="Decision"><display x="15" y="-135" w="90" h="45" /><decision expression="[Login OK]" /><ontrue>5a75fa69-ba8e-5664-9d7b-007f84a4f432</ontrue><onfalse>16bf4c1a-6286-5fc2-adfc-4401927e4fb2</onfalse></stage>
<stage stageid="16bf4c1a-6286-5fc2-adfc-4401927e4fb2" name="Error de login" type="Exception"><loginhibit /><display x="150" y="-135" w="90" h="30" /><exception type="System Exception" detail='"No se pudo autenticar en la plataforma: " &amp; [Mensaje]' /></stage>
<stage stageid="5a75fa69-ba8e-5664-9d7b-007f84a4f432" name="Latido inicio" type="Action"><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="-75" w="90" h="30" /><inputs><input type="text" name="UrlBase" expr="[URL API]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Mensaje" expr='"Robot iniciado: revisando carpeta de reportes"' /><input type="number" name="Archivos" expr="0" /></inputs><outputs></outputs><onsuccess>03b3dd21-8d70-57e2-85a9-93e04719f1b2</onsuccess><resource object="Teleton - API Conector" action="Latido" /></stage>
<stage stageid="03b3dd21-8d70-57e2-85a9-93e04719f1b2" name="Listar reportes pendientes" type="Action"><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="-15" w="90" h="30" /><inputs><input type="text" name="Carpeta" expr="[Carpeta Entrada]" /><input type="text" name="Patron" expr='"*.xlsx"' /></inputs><outputs><output type="collection" name="Archivos" stage="Archivos" /><output type="number" name="Cantidad" stage="Cantidad Archivos" /></outputs><onsuccess>36824e8a-cb1a-51e9-a59a-bd7f2999a800</onsuccess><resource object="Teleton - API Conector" action="Listar Archivos" /></stage>
<stage stageid="36824e8a-cb1a-51e9-a59a-bd7f2999a800" name="¿Hay archivos?" type="Decision"><display x="15" y="45" w="90" h="45" /><decision expression="[Cantidad Archivos] &gt; 0" /><ontrue>425e7c67-6c91-5116-a19e-a555f4c955f3</ontrue><onfalse>7425de2e-858c-5bd4-9335-d3535e71ffed</onfalse></stage>
<stage stageid="7425de2e-858c-5bd4-9335-d3535e71ffed" name="Latido sin archivos" type="Action"><narrative></narrative><loginhibit onsuccess="true" /><display x="165" y="45" w="90" h="30" /><inputs><input type="text" name="UrlBase" expr="[URL API]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Mensaje" expr='"Sin reportes nuevos en la carpeta de entrada"' /><input type="number" name="Archivos" expr="0" /></inputs><outputs></outputs><onsuccess>3dbad973-1e1e-524b-9f3a-caf6e30d9c6f</onsuccess><resource object="Teleton - API Conector" action="Latido" /></stage>
<stage stageid="425e7c67-6c91-5116-a19e-a555f4c955f3" name="Agregar archivos a la cola" type="Action"><narrative>Cada fila de Archivos (Nombre, Ruta, Tipo) se convierte en un ítem de la cola. Clave: Nombre.</narrative><loginhibit onsuccess="true" /><display x="15" y="105" w="90" h="30" /><inputs><input type="text" name="Queue Name" expr='"Teleton - Reportes"' /><input type="collection" name="Data" expr="[Archivos]" /></inputs><outputs><output type="collection" name="Item IDs" stage="Items Agregados" /></outputs><onsuccess>709ff2d5-916a-5772-bb35-15fec201e126</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Add To Queue" /></stage>
<stage stageid="709ff2d5-916a-5772-bb35-15fec201e126" name="Tomar siguiente ítem" type="Action"><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="165" w="90" h="30" /><inputs><input type="text" name="Queue Name" expr='"Teleton - Reportes"' /></inputs><outputs><output type="text" name="Item ID" stage="Item ID" /><output type="collection" name="Data" stage="Item Data" /></outputs><onsuccess>a765eff3-9542-5f3f-b372-613a725885df</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Next Item" /></stage>
<stage stageid="a765eff3-9542-5f3f-b372-613a725885df" name="¿Hay ítem?" type="Decision"><display x="15" y="225" w="90" h="45" /><decision expression='Trim([Item ID]) &lt;&gt; ""' /><ontrue>829cb17e-94ea-5bb1-a28a-575447c53436</ontrue><onfalse>95a866a2-5736-5576-9964-72149b9d4aec</onfalse></stage>
<stage stageid="829cb17e-94ea-5bb1-a28a-575447c53436" name="Procesar Archivo" type="SubSheet"><loginhibit onsuccess="true" /><display x="-135" y="225" w="90" h="30" /><inputs><input type="text" name="Ruta" expr="[Item Data.Ruta]" /><input type="text" name="Nombre" expr="[Item Data.Nombre]" /><input type="text" name="Tipo" expr="[Item Data.Tipo]" /></inputs><outputs><output type="flag" name="OK" stage="Item OK" /><output type="text" name="Mensaje" stage="Mensaje" /></outputs><onsuccess>b38bf869-1f53-5ddd-9c22-9b11daf6cd73</onsuccess><processid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</processid></stage>
<stage stageid="b38bf869-1f53-5ddd-9c22-9b11daf6cd73" name="¿Ítem OK?" type="Decision"><display x="-135" y="285" w="90" h="45" /><decision expression="[Item OK]" /><ontrue>0764e8df-7ee7-5767-8dde-8220ff3daa19</ontrue><onfalse>b48295bc-001c-5e52-ab6e-aeafbc3f0590</onfalse></stage>
