<stage stageid="fc189e5a-efc4-5ef1-b987-079fc2d66818" name="Institutos" type="Collection"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative></narrative><display x="180" y="-135" w="90" h="30" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="IT" type="number" /><field name="Codigo" type="text" /><field name="Nombre" type="text" /><field name="Correo" type="text" /><field name="Resumen" type="text" /></collectioninfo></stage>
