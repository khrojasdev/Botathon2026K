<stage stageid="12f6b2b4-dec6-564a-a984-f1300d40c0df" name="Nota" type="Note"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><narrative>Valida cada fila ANTES de enviarla. Las filas con error no se envían como datos: quedan en un CSV en la carpeta de errores y se informan a la plataforma para que el equipo de planificación las vea.</narrative><display x="-240" y="-255" w="210" h="120" /></stage>
<stage stageid="7312f841-4e6d-531f-9ba3-6290a264cddb" name="Start" type="Start"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit /><display x="15" y="-195" w="60" h="30" /><onsuccess>22be071d-805a-5405-8781-09d1738283bc</onsuccess></stage>
<stage stageid="22be071d-805a-5405-8781-09d1738283bc" name="Obtener institutos" type="Action"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="-135" w="90" h="30" /><inputs><input type="text" name="UrlBase" expr="[URL API]" /><input type="text" name="Token" expr="[Token]" /></inputs><outputs><output type="collection" name="Institutos" stage="Institutos" /></outputs><onsuccess>9d9f35bd-86f5-52d9-bcda-9d8686f27d80</onsuccess><resource object="Teleton - API Conector" action="Obtener Institutos" /></stage>
<stage stageid="9d9f35bd-86f5-52d9-bcda-9d8686f27d80" name="Por cada instituto" type="LoopStart"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit /><display x="15" y="-75" w="90" h="30" /><onsuccess>9fb1cbf6-600d-582a-ba51-ff803c700969</onsuccess><groupid>5f9a52c5-4fe3-5653-b446-0438830750ee</groupid><looptype>ForEach</looptype><loopdata>Institutos</loopdata></stage>
<stage stageid="9fb1cbf6-600d-582a-ba51-ff803c700969" name="URL del PDF" type="Calculation"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-15" w="90" h="30" /><onsuccess>a238e35d-8f77-511b-957c-803cd6edae10</onsuccess><calculation expression='[URL API] &amp; "/api/reportes/instituto/" &amp; [Institutos.IT] &amp; ".pdf"' stage="URL PDF" /></stage>
<stage stageid="a238e35d-8f77-511b-957c-803cd6edae10" name="Ruta del PDF" type="Calculation"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit onsuccess="true" /><display x="15" y="45" w="90" h="30" /><onsuccess>87842b9a-98db-5894-8f5a-1421744c08f0</onsuccess><calculation expression='[Carpeta Reportes] &amp; "\" &amp; FormatDate(Today(), "yyyy-MM-dd") &amp; "\Planificacion_" &amp; [Institutos.Codigo] &amp; ".pdf"' stage="Ruta PDF" /></stage>
<stage stageid="87842b9a-98db-5894-8f5a-1421744c08f0" name="Descargar PDF" type="Action"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="105" w="90" h="30" /><inputs><input type="text" name="Url" expr="[URL PDF]" /><input type="text" name="Token" expr="[Token]" /><input type="text" name="Ruta" expr="[Ruta PDF]" /></inputs><outputs><output type="flag" name="Exito" stage="Descarga OK" /><output type="number" name="Bytes" stage="Bytes" /></outputs><onsuccess>c8963f75-a803-5c07-ba5e-60fd41bf13f0</onsuccess><resource object="Teleton - API Conector" action="Descargar Archivo" /></stage>
<stage stageid="c8963f75-a803-5c07-ba5e-60fd41bf13f0" name="Preparar correo a jefatura" type="Action"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative>Deja un borrador .eml con el PDF adjunto. No se envía solo: la jefatura de planificación lo revisa y lo envía desde Outlook.</narrative><loginhibit onsuccess="true" /><display x="15" y="135" w="90" h="30" /><inputs><input type="text" name="Para" expr="[Institutos.Correo]" /><input type="text" name="Asunto" expr='"Planificación asistencial 2026 - IT " &amp; [Institutos.Nombre] &amp; " (" &amp; FormatDate(Today(), "dd-MM-yyyy") &amp; ")"' /><input type="text" name="Cuerpo" expr="[Institutos.Resumen]" /><input type="text" name="Adjunto" expr="[Ruta PDF]" /><input type="text" name="Carpeta" expr='[Carpeta Reportes] &amp; "\" &amp; FormatDate(Today(), "yyyy-MM-dd") &amp; "\Correos"' /></inputs><outputs><output type="text" name="RutaEml" stage="Ruta Correo" /></outputs><onsuccess>c81c1af7-78ce-5c66-9d86-222e8c923855</onsuccess><resource object="Teleton - API Conector" action="Preparar Correo" /></stage>
<stage stageid="c81c1af7-78ce-5c66-9d86-222e8c923855" name="Por cada instituto" type="LoopEnd"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit /><display x="15" y="195" w="90" h="30" /><onsuccess>ba6c71a0-eb73-5feb-87c0-194f012cc440</onsuccess><groupid>5f9a52c5-4fe3-5653-b446-0438830750ee</groupid></stage>
<stage stageid="ba6c71a0-eb73-5feb-87c0-194f012cc440" name="End" type="End"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><loginhibit /><display x="15" y="255" w="60" h="30" /></stage>
