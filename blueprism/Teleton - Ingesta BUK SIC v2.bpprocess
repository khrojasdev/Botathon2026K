<stage stageid="136c060f-dc82-55b8-ba1c-fe843f417b4a" name="Descarga OK" type="Data"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative></narrative><display x="300" y="-75" w="90" h="30" /><datatype>flag</datatype><initialvalue xml:space="preserve">False</initialvalue><private /><alwaysinit /></stage>
<stage stageid="ad04941c-e2a1-58ba-b408-fd65e95cef46" name="Bytes" type="Data"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative></narrative><display x="300" y="-25" w="90" h="30" /><datatype>number</datatype><initialvalue xml:space="preserve">0</initialvalue><private /><alwaysinit /></stage>
<stage stageid="62b59d5b-2301-50af-b8ba-afe6a04e5ed2" name="Nota" type="Note"><subsheetid>cfcdd994-96ff-529a-a323-ea0c60e3e9fc</subsheetid><narrative>Distribución automática: deja en Carpeta Reportes\&lt;fecha&gt; un PDF por instituto. Opcional: agrega aquí una acción "Send Message" del VBO de Outlook para enviarlo a cada jefatura.</narrative><display x="-240" y="-195" w="210" h="100" /></stage>
</process>