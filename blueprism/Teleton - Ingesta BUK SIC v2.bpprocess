<stage stageid="b5a1d5ba-bac3-54f5-b07b-fab8af30cd0c" name="Flujo" type="Note"><narrative>Robot "Cada hora cuenta": 1) inicia sesión en la plataforma, 2) toma cada Excel de BUK/SIC de la carpeta de entrada, 3) lo lee y valida fila a fila, 4) envía sólo lo válido y deja un CSV de errores, 5) mueve el archivo a Procesados, 6) descarga el PDF de planificación de cada instituto para sus jefaturas.</narrative><display x="-240" y="0" w="210" h="150" /></stage>
<stage stageid="3fc737c9-8335-5e55-a9f8-4d3086f97f1b" name="Start" type="Start"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><loginhibit /><display x="15" y="-255" w="60" h="30" /><inputs><input type="text" name="Ruta" stage="Ruta" /><input type="text" name="Nombre" stage="Nombre" /><input type="text" name="Tipo" stage="Tipo" /></inputs><onsuccess>e50010f3-13f9-5c19-b5b8-613e6091309f</onsuccess></stage>
<stage stageid="e50010f3-13f9-5c19-b5b8-613e6091309f" name="¿Tipo reconocido?" type="Decision"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><display x="15" y="-195" w="90" h="45" /><decision expression='[Tipo] &lt;&gt; "DESCONOCIDO"' /><ontrue>fc7bb5be-aa67-5036-b00d-42ff7720b9df</ontrue><onfalse>476a60f6-ff87-537e-9554-56871304d92d</onfalse></stage>
<stage stageid="476a60f6-ff87-537e-9554-56871304d92d" name="Archivo no reconocido a Errores" type="Action"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="165" y="-195" w="90" h="30" /><inputs><input type="text" name="Origen" expr="[Ruta]" /><input type="text" name="CarpetaDestino" expr="[Carpeta Errores]" /></inputs><outputs><output type="text" name="NuevaRuta" stage="Nueva Ruta" /></outputs><onsuccess>f999d857-64f2-584e-bc8b-e139a1bd9151</onsuccess><resource object="Teleton - API Conector" action="Mover Archivo" /></stage>
<stage stageid="fc7bb5be-aa67-5036-b00d-42ff7720b9df" name="Leer Excel" type="Action"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="15" y="-135" w="90" h="30" /><inputs><input type="text" name="Ruta" expr="[Ruta]" /></inputs><outputs><output type="collection" name="Datos" stage="Datos" /><output type="number" name="Filas" stage="Filas" /><output type="text" name="Hoja" stage="Hoja" /></outputs><onsuccess>7e75b169-63b0-5a4f-b288-ee64e1e17470</onsuccess><resource object="Teleton - API Conector" action="Leer Excel" /></stage>
<stage stageid="7e75b169-63b0-5a4f-b288-ee64e1e17470" name="¿Es SIC?" type="Decision"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><display x="15" y="-75" w="90" h="45" /><decision expression='[Tipo] = "SIC"' /><ontrue>21089ae6-5fdb-57a9-b946-7dc68fc37a1f</ontrue><onfalse>96681744-a78d-573b-9a6f-6cb01564b5a8</onfalse></stage>
<stage stageid="21089ae6-5fdb-57a9-b946-7dc68fc37a1f" name="Validar SIC" type="Action"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="165" y="-75" w="90" h="30" /><inputs><input type="collection" name="Datos" expr="[Datos]" /></inputs><outputs><output type="collection" name="Validos" stage="Validos" /><output type="collection" name="Errores" stage="Errores" /><output type="number" name="CantValidos" stage="Cant Validos" /><output type="number" name="CantErrores" stage="Cant Errores" /></outputs><onsuccess>f1883b7a-347a-5ad6-8349-1584e156b37b</onsuccess><resource object="Teleton - API Conector" action="Validar Reporte SIC" /></stage>
<stage stageid="96681744-a78d-573b-9a6f-6cb01564b5a8" name="Validar BUK" type="Action"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><narrative></narrative><loginhibit onsuccess="true" /><display x="-135" y="-75" w="90" h="30" /><inputs><input type="collection" name="Datos" expr="[Datos]" /><input type="number" name="JornadaMaxEneAbr" expr="44" /><input type="number" name="JornadaMaxMayDic" expr="42" /></inputs><outputs><output type="collection" name="Validos" stage="Validos" /><output type="collection" name="Errores" stage="Errores" /><output type="number" name="CantValidos" stage="Cant Validos" /><output type="number" name="CantErrores" stage="Cant Errores" /></outputs><onsuccess>f1883b7a-347a-5ad6-8349-1584e156b37b</onsuccess><resource object="Teleton - API Conector" action="Validar Reporte BUK" /></stage>
<stage stageid="f1883b7a-347a-5ad6-8349-1584e156b37b" name="¿Hay errores?" type="Decision"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><display x="15" y="-15" w="90" h="45" /><decision expression="[Cant Errores] &gt; 0" /><ontrue>03c11cfd-3907-5464-ae97-fb1f2b6e7750</ontrue><onfalse>1904a5fd-e075-5494-b8f4-8502c54c5908</onfalse></stage>
<stage stageid="03c11cfd-3907-5464-ae97-fb1f2b6e7750" name="Ruta CSV errores" type="Calculation"><subsheetid>ebffdfa3-5d48-53ec-bc67-0f2bdccd07e7</subsheetid><loginhibit onsuccess="true" /><display x="165" y="-15" w="90" h="30" /><onsuccess>ae512516-3604-53ae-b286-fab10318ecd9</onsuccess><calculation expression='[Carpeta Errores] &amp; "\" &amp; Replace([Nombre], ".xlsx", "") &amp; "_errores_" &amp; FormatDateTime(Now(), "yyyyMMdd_HHmmss") &amp; ".csv"' stage="Ruta CSV" /></stage>
